{
  "name": "bookmark-studio",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "A local-first bookmark manager and knowledge base. Runs as a website, a Chrome extension, or a small local server, all from one codebase. No account, no AI, no tracking.",
  "keywords": [
    "bookmarks",
    "bookmark-manager",
    "local-first",
    "chrome-extension",
    "pwa",
    "knowledge-base",
    "offline"
  ],
  "homepage": "https://github.com/harsh040506/bookmark-studio#readme",
  "bugs": {
    "url": "https://github.com/harsh040506/bookmark-studio/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/harsh040506/bookmark-studio.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web && npm run build:extension && npm run build:server",
    "build:web": "node scripts/build-web.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "build:server": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/server/server.js",
    "start": "node scripts/start.mjs",
    "preview": "vite preview --outDir dist/web",
    "check": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke.mjs",
    "icons": "node scripts/build-icons.mjs",
    "media": "node scripts/capture-media.mjs",
    "check:site": "node scripts/check-site.mjs",
    "build:vercel": "npm run build:web && npm run build:extension"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.8",
    "cheerio": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "express": "^4.21.2",
    "motion": "^12.43.0",
    "puppeteer-core": "^25.16.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/chrome": "^0.0.287",
    "@types/express": "^4.17.21",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "archiver": "^7.0.1",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.1",
    "typescript": "5.6.3",
    "vite": "^7.1.7",
    "vitest": "^2.1.4"
  }
}
