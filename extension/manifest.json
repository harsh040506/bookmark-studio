{
  "manifest_version": 3,
  "name": "Bookmark Studio",
  "version": "0.0.0",
  "description": "A calm home for your bookmarks: synced two-way with Chrome, with real search, link checks, previews and duplicate detection. No account, no AI.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Open Bookmark Studio"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "bookmarks",
    "tabs",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [],
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/harsh040506/bookmark-studio",
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
